# Product rating source contract of a core newer than the published one: Comment::configureServices() wires
# Front/RatingFacetSource.php only when interface_exists() finds it. Kept out of the report so that PHPStan runs
# against the published core; an entry the core catches up with is not reported.
parameters:
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Class Comment\\Front\\RatingFacetSource implements unknown interface Thelia\\Domain\\Catalog\\Product\\ProductRatingSourceInterface\.$#'
            count: 1
            path: Front/RatingFacetSource.php
